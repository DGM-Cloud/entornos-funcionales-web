# Cabeceras para activos estáticos de Cloudflare Pages.
# No aplican a respuestas de Pages Functions (/api/*).
# CSP omitida a propósito: Angular + Turnstile requieren validación post-deploy.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/ard.json
  Content-Type: application/ard+json; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/ai-catalog.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
